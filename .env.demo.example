# ======================================================================
# DEMO (.env.demo) — dipakai `./run.sh` / `./run.sh demo` (lokal/showcase).
# Stack TERPISAH dari produksi (port, DB & volume beda). Bukan data nyata.
# ======================================================================

WEB_PORT=8094

APP_NAME="Desa Cigagade (Demo)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8094

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_DATABASE=db_desa_cigagade_demo
DB_USERNAME=demo
DB_PASSWORD=demo123
DB_ROOT_PASSWORD=demoroot123

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="demo@desacigagade.test"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NAME="Admin Demo"
ADMIN_EMAIL=admin@demo.test
ADMIN_PASSWORD=Demo12345

VITE_APP_NAME="${APP_NAME}"
