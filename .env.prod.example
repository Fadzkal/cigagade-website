# ======================================================================
# PRODUKSI (.env.prod) — dipakai `./run.sh deploy` di server lab (trinserver).
# Copy otomatis oleh run.sh. GANTI semua nilai GANTI_... sebelum deploy.
# File .env biasa tetap untuk dev lokal (php artisan serve), tidak disentuh.
# ======================================================================

# --- Docker / server ---
# Port host (bind 127.0.0.1). Cloudflare Tunnel: Public Hostname -> localhost:WEB_PORT.
# 8088 & 33061 sudah dipakai koperasi-app — pastikan port ini bebas (`ss -ltn`).
WEB_PORT=8093

# --- Aplikasi ---
APP_NAME="Desa Cigagade"
APP_ENV=production
# Dibuat otomatis oleh run.sh bila kosong.
APP_KEY=
APP_DEBUG=false
APP_URL=https://cigagade.trin-polman.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# --- Database (container MariaDB; host/port di-set compose) ---
DB_DATABASE=db_desa_cigagade
DB_USERNAME=cigagade
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_DB_KUAT

# --- Sesi & cache ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_FROM_ADDRESS="desa.cigagade@garutkab.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# --- Admin pertama (dibuat sekali oleh EssentialSeeder) ---
ADMIN_NAME="Administrator Desa Cigagade"
ADMIN_EMAIL=admin@desacigagade.id
ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KUAT

VITE_APP_NAME="${APP_NAME}"
